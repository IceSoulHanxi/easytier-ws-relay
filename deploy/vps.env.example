# HTTP / WS mode: allow this TCP port in your VPS security group.
RELAY_PORT=8787
BIND_ADDRESS=0.0.0.0
WS_PATH=ws
EASYTIER_PUBLIC_SERVER_NETWORK_NAME=public_server
EASYTIER_DISABLE_RELAY=0

# For WSS, point this domain's A/AAAA records to the VPS, open TCP 80/443,
# set BIND_ADDRESS=127.0.0.1 and run: bash scripts/deploy-vps.sh up --tls
RELAY_DOMAIN=
